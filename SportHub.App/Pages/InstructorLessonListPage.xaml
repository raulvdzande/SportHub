<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportHub.App.ViewModels"
             xmlns:lessons="clr-namespace:SportHub.Shared.DTOs.Lessons;assembly=SportHub.Shared"
             x:Class="SportHub.App.Pages.InstructorLessonListPage"
             x:DataType="vm:InstructorLessonListViewModel"
             x:Name="ThisPage"
             Title="My Lessons">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="15,10" Spacing="8" BackgroundColor="White">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                <Button Text="↻ Refresh"
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="#007AFF"
                        TextColor="White"
                        CornerRadius="8"
                        FontSize="12" />
                <Button Text="🚪 Sign Out"
                        Command="{Binding LogoutCommand}"
                        BackgroundColor="#FF3B30"
                        TextColor="White"
                        CornerRadius="8"
                        FontSize="12" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#007AFF" />

            <Label Text="{Binding Error}"
                   TextColor="#FF3B30" FontSize="12"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding Error, Converter={StaticResource StringNotEmptyToBool}}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15,5" Spacing="8">
                <Label Text="This Week"
                       FontSize="16" FontAttributes="Bold"
                       Margin="0,10,0,5" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lessons}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="lessons:MobileLessonSummaryDto">
                            <Border Padding="12" StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#F2F2F7" StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.LessonTappedCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto,Auto">
                                    <Label Grid.Row="0"
                                           Text="{Binding WorkoutName}"
                                           FontSize="14" FontAttributes="Bold" />

                                    <Label Grid.Row="1"
                                           FontSize="12" TextColor="#8E8E93">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding StartTimeUtc, StringFormat='{0:dd MMM HH:mm}'}" />
                                                <Span Text=" · " />
                                                <Span Text="{Binding DurationMinutes, StringFormat='{0} min'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label Grid.Row="2"
                                           Text="{Binding LocationName, StringFormat='📍 {0}'}"
                                           FontSize="12" TextColor="#8E8E93" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="No lessons this week."
                       FontSize="14" TextColor="#8E8E93"
                       HorizontalTextAlignment="Center"
                       Margin="0,20" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
