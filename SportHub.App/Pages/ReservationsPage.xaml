<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportHub.App.ViewModels"
             xmlns:reservations="clr-namespace:SportHub.Shared.DTOs.Reservations;assembly=SportHub.Shared"
             x:Class="SportHub.App.Pages.ReservationsPage"
             x:DataType="vm:ReservationsViewModel"
             x:Name="ThisPage"
             Title="My Reservations">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="15,10" Spacing="8" BackgroundColor="White">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                <Button Text="↻ Refresh"
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="#007AFF"
                        TextColor="White"
                        CornerRadius="8"
                        FontSize="12" />
                <Button Text="+ Reserve"
                        Command="{Binding ReserveCommand}"
                        BackgroundColor="#34C759"
                        TextColor="White"
                        CornerRadius="8"
                        FontSize="12" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#007AFF" />

            <Label Text="{Binding Error}"
                   TextColor="#FF3B30" FontSize="12"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding Error, Converter={StaticResource StringNotEmptyToBool}}" />

            <Label Text="{Binding StatusMessage}"
                   TextColor="#34C759" FontSize="12"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToBool}}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15,5" Spacing="8">
                <Label Text="Upcoming Reservations"
                       FontSize="16" FontAttributes="Bold"
                       IsVisible="{Binding Reservations, Converter={StaticResource StringNotEmptyToBool}}"
                       Margin="0,10,0,5" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Reservations}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="reservations:LessonReservationDto">
                            <Border Padding="12" StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#F2F2F7" StrokeThickness="0">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding WorkoutName}"
                                           FontSize="14" FontAttributes="Bold" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding LessonStartTimeUtc, StringFormat='{0:HH:mm}'}"
                                           FontSize="14" FontAttributes="Bold" TextColor="#007AFF" />

                                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{Binding LocationName, StringFormat='📍 {0}'}"
                                           FontSize="12" TextColor="#8E8E93" />

                                    <Label Grid.Row="2" Grid.ColumnSpan="2"
                                           Text="{Binding Status, StringFormat='Status: {0}'}"
                                           FontSize="12" TextColor="#8E8E93" />

                                    <Label Grid.Row="3" Grid.ColumnSpan="2"
                                           Text="{Binding WaitlistPosition, StringFormat='Waitlist position: {0}'}"
                                           FontSize="11" TextColor="#FF9500"
                                           IsVisible="{Binding WaitlistPosition}" />

                                    <Button Grid.Row="4" Grid.ColumnSpan="2"
                                            Text="Cancel"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.CancelCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#FF3B30"
                                            TextColor="White"
                                            CornerRadius="6"
                                            FontSize="12"
                                            Margin="0,8,0,0"
                                            Padding="0,6" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="You have no reservations."
                       FontSize="14" TextColor="#8E8E93"
                       HorizontalTextAlignment="Center"
                       Margin="0,20" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
