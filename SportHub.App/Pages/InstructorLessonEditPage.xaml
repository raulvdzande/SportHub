<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SportHub.App.Pages.InstructorLessonEditPage"
             Title="Create Lesson">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Lesson Details"
               FontSize="18"
               FontAttributes="Bold"/>

        <Label Text="Workout Type"
               FontSize="14"
               FontAttributes="Bold"/>
        <Picker ItemsSource="{Binding Workouts}"
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedWorkout}"
                Title="Select workout type"/>

        <Label Text="Location"
               FontSize="14"
               FontAttributes="Bold"/>
        <Picker ItemsSource="{Binding Locations}"
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedLocation}"
                Title="Select location"/>

        <Label Text="Start Date and Time"
               FontSize="14"
               FontAttributes="Bold"/>
        <DatePicker Date="{Binding LessonDate}"/>
        <TimePicker Time="{Binding LessonTime}"/>

        <Label Text="Duration (minutes)"
               FontSize="14"
               FontAttributes="Bold"/>
        <Entry Placeholder="45"
               Text="{Binding DurationMinutes}"
               Keyboard="Numeric"/>

        <Label Text="Capacity"
               FontSize="14"
               FontAttributes="Bold"/>
        <Entry Placeholder="20"
               Text="{Binding Capacity}"
               Keyboard="Numeric"/>

        <Label Text="{Binding Error}"
               TextColor="Red"
               IsVisible="{Binding Error, Converter={StaticResource StringNotEmptyToBool}}"
               Margin="0,10"/>

        <StackLayout Spacing="10" Margin="0,20">
            <Button Text="Save"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                    BackgroundColor="#51B968"
                    TextColor="White"
                    Padding="15"
                    CornerRadius="8"/>

            <Button Text="Cancel"
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                    BackgroundColor="#999"
                    TextColor="White"
                    Padding="15"
                    CornerRadius="8"/>
        </StackLayout>

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="#51B968"/>

    </VerticalStackLayout>

</ContentPage>
