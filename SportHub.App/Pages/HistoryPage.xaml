<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportHub.App.ViewModels"
             xmlns:checkins="clr-namespace:SportHub.Shared.DTOs.CheckIns;assembly=SportHub.Shared"
             x:Class="SportHub.App.Pages.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             Title="Lesson History">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="15,10" Spacing="8" BackgroundColor="White">
            <Button Text="↻ Refresh"
                    Command="{Binding RefreshCommand}"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    CornerRadius="8"
                    FontSize="12" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#007AFF" />

            <Label Text="{Binding Error}"
                   TextColor="#FF3B30" FontSize="12"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding Error, Converter={StaticResource StringNotEmptyToBool}}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15,5" Spacing="8">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding History}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="checkins:CheckInDto">
                            <Border Padding="12" StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#F2F2F7" StrokeThickness="0">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                    <Label Grid.Row="0"
                                           Text="{Binding WorkoutName}"
                                           FontSize="14" FontAttributes="Bold" />

                                    <Label Grid.Row="1"
                                           Text="{Binding LessonStartTimeUtc, StringFormat='⏰ {0:dd MMM yyyy HH:mm}'}"
                                           FontSize="12" TextColor="#8E8E93" />

                                    <Label Grid.Row="2"
                                           Text="{Binding LocationName, StringFormat='📍 {0}'}"
                                           FontSize="12" TextColor="#8E8E93" />

                                    <Label Grid.Row="3"
                                           Text="{Binding Method, StringFormat='Checked in via: {0}'}"
                                           FontSize="11" TextColor="#34C759" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="No lesson history (last 12 months)."
                       FontSize="14" TextColor="#8E8E93"
                       HorizontalTextAlignment="Center"
                       Margin="0,20"
                       IsVisible="{Binding HasHistory, Converter={StaticResource InvertBool}}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
