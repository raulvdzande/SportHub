<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportHub.App.ViewModels"
             xmlns:reservations="clr-namespace:SportHub.Shared.DTOs.Reservations;assembly=SportHub.Shared"
             x:Class="SportHub.App.Pages.InstructorLessonDetailsPage"
             x:DataType="vm:InstructorLessonDetailsViewModel"
             x:Name="ThisPage"
             Title="Lesson Details">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="10">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#007AFF" />

            <Label Text="{Binding Error}"
                   TextColor="#FF3B30" FontSize="12"
                   IsVisible="{Binding Error, Converter={StaticResource StringNotEmptyToBool}}" />

            <!-- Lesson information -->
            <Label Text="{Binding Lesson.WorkoutName}"
                   FontSize="22" FontAttributes="Bold"
                   IsVisible="{Binding Lesson}" />

            <VerticalStackLayout Spacing="8" IsVisible="{Binding Lesson}">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="⏰" FontSize="14" VerticalOptions="Center" />
                    <Label Text="{Binding Lesson.StartTimeUtc, StringFormat='{0:HH:mm}'}"
                           FontSize="14" VerticalOptions="Center" />
                    <Label Text="{Binding Lesson.DurationMinutes, StringFormat='({0} min)'}"
                           FontSize="12" TextColor="Gray" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="8">
                    <Label Text="📍" FontSize="14" VerticalOptions="Center" />
                    <Label Text="{Binding Lesson.LocationName}"
                           FontSize="14" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="8">
                    <Label Text="👥" FontSize="14" VerticalOptions="Center" />
                    <Label Text="{Binding Lesson.RegisteredCount, StringFormat='Participants: {0}'}"
                           FontSize="14" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Check-in button -->
            <Button Text="✓ Register Check In"
                    Command="{Binding CheckInCommand}"
                    BackgroundColor="#34C759"
                    TextColor="White"
                    CornerRadius="10"
                    FontSize="14"
                    Margin="0,10,0,20"
                    Padding="0,12"
                    IsVisible="{Binding Lesson}" />

            <!-- Reservations -->
            <Label Text="Registrations"
                   FontSize="15" FontAttributes="Bold"
                   Margin="0,10,0,5"
                   IsVisible="{Binding Reservations}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Reservations}" Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="reservations:LessonReservationDto">
                        <Border Padding="10" StrokeShape="RoundRectangle 8"
                                BackgroundColor="#F2F2F7" StrokeThickness="0">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Status, StringFormat='Status: {0}'}"
                                       FontSize="12" FontAttributes="Bold" />
                                <Label Text="{Binding WaitlistPosition, StringFormat='Waitlist position: {0}'}"
                                       FontSize="11" TextColor="#FF9500"
                                       IsVisible="{Binding WaitlistPosition}" />
                                <Label Text="{Binding CreatedAtUtc, StringFormat='Registered: {0:dd MMM HH:mm}'}"
                                       FontSize="11" TextColor="#8E8E93" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="No registrations."
                   FontSize="12" TextColor="#8E8E93"
                   HorizontalTextAlignment="Center"
                   Margin="0,20" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
