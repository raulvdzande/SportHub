<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportHub.App.ViewModels"
             x:Class="SportHub.App.Pages.InstructorLoginPage"
             Title="Instructor Login">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">
            <Label Text="SportHub Instructor"
                   FontSize="28" FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,20" />

            <Entry Placeholder="Email"
                   Text="{Binding Email}"
                   Keyboard="Email"
                   FontSize="14" />

            <Entry Placeholder="Password"
                   Text="{Binding Password}"
                   IsPassword="True"
                   FontSize="14" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#007AFF" />

            <Label Text="{Binding Error}"
                   TextColor="#FF3B30" FontSize="12"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding Error, Converter={StaticResource StringNotEmptyToBool}}" />

            <Button Text="Sign In"
                    Command="{Binding LoginCommand}"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    CornerRadius="10"
                    FontSize="14"
                    Margin="0,10,0,0"
                    Padding="0,12" />

            <Button Text="Back to Member Login"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="#007AFF"
                    FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
