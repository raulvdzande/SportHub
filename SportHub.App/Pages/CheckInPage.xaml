<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SportHub.App.ViewModels"
             x:Class="SportHub.App.Pages.CheckInPage"
             x:DataType="vm:CheckInViewModel"
             x:Name="ThisPage"
             Title="Check In">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="12">

            <!-- Status messages -->
            <Label Text="{Binding Error}"
                   TextColor="#FF3B30" FontSize="12"
                   FontAttributes="Bold"
                   IsVisible="{Binding Error, Converter={StaticResource StringNotEmptyToBool}}" />

            <Label Text="{Binding StatusMessage}"
                   TextColor="#34C759" FontSize="12"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToBool}}" />

            <!-- Current lesson information -->
            <Border Padding="12" StrokeShape="RoundRectangle 10"
                    BackgroundColor="#F2F2F7" StrokeThickness="0"
                    IsVisible="{Binding CurrentLesson}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding CurrentLesson.WorkoutName}"
                           FontSize="16" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="{Binding CurrentLesson.StartTimeUtc, StringFormat='⏰ {0:HH:mm}'}"
                               FontSize="12" TextColor="#8E8E93" />
                        <Label Text="{Binding CurrentLesson.DurationMinutes, StringFormat='⏱️ {0}m'}"
                               FontSize="12" TextColor="#8E8E93" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding CurrentLesson.LocationName, StringFormat='📍 {0}'}"
                           FontSize="12" TextColor="#8E8E93" />
                </VerticalStackLayout>
            </Border>

            <!-- Check-in method selection -->
            <Label Text="Select check-in method"
                   FontSize="14" FontAttributes="Bold"
                   Margin="0,5,0,0" />

            <Picker Title="Select method"
                    SelectedItem="{Binding Method}"
                    IsEnabled="{Binding IsScanning, Converter={StaticResource InvertBool}}">
                <Picker.Items>
                    <x:String>Manual</x:String>
                    <x:String>Rfid</x:String>
                    <x:String>Gps</x:String>
                </Picker.Items>
            </Picker>

            <!-- Check-in methods -->
            <VerticalStackLayout IsVisible="{Binding Method}" Spacing="8">
                <Label Text="{Binding Method, StringFormat='Selected method: {0}'}"
                       FontSize="12" TextColor="#8E8E93" />

                <!-- Manual -->
                <Border Padding="12" StrokeShape="RoundRectangle 10"
                        BackgroundColor="#E8F5E9" StrokeThickness="1"
                        Stroke="#4CAF50"
                        IsVisible="{Binding Method}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="✓ Manual Check In"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="#2E7D32" />
                        <Label Text="Standard check-in without hardware"
                               FontSize="11" TextColor="#558B2F" />
                    </VerticalStackLayout>
                </Border>

                <!-- RFID Scanner -->
                <Border Padding="12" StrokeShape="RoundRectangle 10"
                        BackgroundColor="#E3F2FD" StrokeThickness="1"
                        Stroke="#2196F3"
                        IsVisible="{Binding Method}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🏷️ RFID Tag Reader"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="#1565C0" />

                        <Button Text="{Binding IsScanning, StringFormat='Scanning...', FallbackValue='📡 Start RFID Scan'}"
                                Command="{Binding StartRfidScanCommand}"
                                BackgroundColor="#2196F3"
                                TextColor="White"
                                CornerRadius="8"
                                FontSize="12"
                                Padding="0,8"
                                IsEnabled="{Binding IsScanning, Converter={StaticResource InvertBool}}" />

                        <ProgressBar Progress="{Binding ScanProgress, Converter={StaticResource StringNotEmptyToBool}}"
                                     ProgressColor="#2196F3"
                                     BackgroundColor="#E3F2FD"
                                     IsVisible="{Binding IsScanning}" />

                        <Label Text="{Binding ScanProgress, StringFormat='{0}%'}"
                               FontSize="11" TextColor="#1565C0" HorizontalTextAlignment="Center"
                               IsVisible="{Binding IsScanning}" />

                        <!-- RFID Result -->
                        <VerticalStackLayout IsVisible="{Binding RfidTag, Converter={StaticResource StringNotEmptyToBool}}"
                                           Spacing="4" Margin="0,8,0,0" Padding="8" BackgroundColor="#FFFFFF">
                            <Label Text="📖 Tag Details:"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="#1565C0" />
                            <Label Text="{Binding RfidTag, StringFormat='Tag ID: {0}'}"
                                   FontSize="10" TextColor="#424242" />
                            <Label Text="{Binding RfidMemberName, StringFormat='Name: {0}'}"
                                   FontSize="10" TextColor="#424242" />
                            <Label Text="{Binding RfidSignalStrength, StringFormat='📊 Signal: {0}%'}"
                                   FontSize="10" TextColor="#F57C00" />
                        </VerticalStackLayout>

                        <Button Text="❌ Cancel Scan"
                                Command="{Binding CancelScanCommand}"
                                BackgroundColor="#EF5350"
                                TextColor="White"
                                CornerRadius="8"
                                FontSize="11"
                                Padding="0,6"
                                IsVisible="{Binding IsScanning}" />
                    </VerticalStackLayout>
                </Border>

                <!-- GPS Location -->
                <Border Padding="12" StrokeShape="RoundRectangle 10"
                        BackgroundColor="#FCE4EC" StrokeThickness="1"
                        Stroke="#E91E63"
                        IsVisible="{Binding Method}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="📍 GPS Location Detection"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="#AD1457" />

                        <Picker Title="Select gym location"
                                SelectedItem="{Binding SelectedGym}"
                                ItemsSource="{Binding AvailableGyms}"
                                FontSize="12" />

                        <Button Text="{Binding IsScanning, StringFormat='Determining location...', FallbackValue='📡 Start GPS Scan'}"
                                Command="{Binding StartGpsScanCommand}"
                                BackgroundColor="#E91E63"
                                TextColor="White"
                                CornerRadius="8"
                                FontSize="12"
                                Padding="0,8"
                                IsEnabled="{Binding IsScanning, Converter={StaticResource InvertBool}}" />

                        <ProgressBar Progress="{Binding ScanProgress, Converter={StaticResource StringNotEmptyToBool}}"
                                     ProgressColor="#E91E63"
                                     BackgroundColor="#FCE4EC"
                                     IsVisible="{Binding IsScanning}" />

                        <Label Text="{Binding ScanProgress, StringFormat='{0}% - Searching satellites'}"
                               FontSize="11" TextColor="#AD1457" HorizontalTextAlignment="Center"
                               IsVisible="{Binding IsScanning}" />

                        <!-- GPS Result -->
                        <VerticalStackLayout IsVisible="{Binding GpsCity, Converter={StaticResource StringNotEmptyToBool}}"
                                           Spacing="4" Margin="0,8,0,0" Padding="8" BackgroundColor="#FFFFFF">
                            <Label Text="📡 GPS Details:"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="#AD1457" />
                            <Label Text="{Binding GpsCity, StringFormat='City: {0}'}"
                                   FontSize="10" TextColor="#424242" />
                            <Label Text="{Binding GpsLatitude, StringFormat='Latitude: {0:F4}°'}"
                                   FontSize="10" TextColor="#424242" />
                            <Label Text="{Binding GpsLongitude, StringFormat='Longitude: {0:F4}°'}"
                                   FontSize="10" TextColor="#424242" />
                            <Label Text="{Binding GpsAccuracy, StringFormat='🎯 Accuracy: {0}m'}"
                                   FontSize="10" TextColor="#F57C00" />
                            <Label Text="{Binding GpsSatellites, StringFormat='🛰️ Satellites: {0}'}"
                                   FontSize="10" TextColor="#F57C00" />
                            <Label Text="{Binding GpsAcquisitionTime, StringFormat='⏱️ Time: {0}ms'}"
                                   FontSize="10" TextColor="#666" />
                        </VerticalStackLayout>

                        <Button Text="❌ Cancel Scan"
                                Command="{Binding CancelScanCommand}"
                                BackgroundColor="#EF5350"
                                TextColor="White"
                                CornerRadius="8"
                                FontSize="11"
                                Padding="0,6"
                                IsVisible="{Binding IsScanning}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Check-in button -->
            <Button Text="✓ Check In"
                    Command="{Binding CheckInCommand}"
                    BackgroundColor="#34C759"
                    TextColor="White"
                    CornerRadius="10"
                    FontSize="14"
                    FontAttributes="Bold"
                    Margin="0,20,0,10"
                    Padding="0,14" />

            <!-- History -->
            <Label Text="Lesson History"
                   FontSize="13" FontAttributes="Bold"
                   Margin="0,10,0,5" />

            <Button Text="📊 View history (last 12 months)"
                    Command="{Binding LoadHistoryCommand}"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    CornerRadius="8"
                    FontSize="12"
                    Padding="0,8" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
