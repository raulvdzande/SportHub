@page "/plans"
@page "/subscriptions"
@implements IDisposable
@using System.Security.Claims
@using SportHub.Shared.DTOs.Members
@using System.ComponentModel.DataAnnotations
@inject SportHub.Web.Services.Localization.LanguageService Language
@inject SportHub.Web.Services.Api.MembershipPlansApiClient PlansApi
@inject SportHub.Web.Services.Api.IMemberSubscriptionsApiClient? MemberSubscriptionsApi
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Abonnementen</PageTitle>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="mb-1">Abonnementen</h1>

            <p class="text-muted mb-0">
                Kies een abonnement en voeg hem direct toe.
            </p>
        </div>

        <button class="btn btn-primary"
                @onclick="OpenEmptySubscriptionModal">
            <i class="bi bi-plus-lg"></i>
            Voeg subscription toe
        </button>

    </div>

    @if (plans == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border"></div>
        </div>
    }
    else if (!plans.Any())
    {
        <div class="alert alert-warning">
            Geen abonnementen beschikbaar.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var plan in plans.OrderBy(p => p.Price))
            {
                <div class="col-lg-4 col-md-6 mb-4">

                    <div class="card h-100 shadow border-0">

                        <div class="card-header bg-primary text-white text-center py-3">
                            <h4 class="mb-0">@plan.Name</h4>
                        </div>

                        <div class="card-body d-flex flex-column">

                            <div class="text-center mb-4">

                                <h2 class="text-primary fw-bold">
                                    €@plan.Price.ToString("F2")
                                </h2>

                                <div class="text-muted">
                                    per @plan.PeriodType
                                </div>

                            </div>

                            <p class="text-muted">
                                @plan.Description
                            </p>

                            <hr />

                            <div class="mb-4">

                                @if (plan.SessionsPerWeekLimit.HasValue)
                                {
                                    <div class="mb-2">
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                        @plan.SessionsPerWeekLimit sessies per week
                                    </div>
                                }

                                <div class="mb-2">
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    Toegang tot groepslessen
                                </div>

                                <div>
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    Support inbegrepen
                                </div>

                            </div>

                            <div class="mt-auto">

                                <button class="btn btn-success w-100"
                                        @onclick="() => OpenSubscriptionModal(plan)">
                                    <i class="bi bi-plus-lg"></i>
                                    Subscription toevoegen
                                </button>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

    <hr class="my-5" />

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3 class="mb-0">
            Jouw actieve abonnementen
        </h3>

        <button class="btn btn-outline-primary"
                @onclick="OpenEmptySubscriptionModal">
            <i class="bi bi-plus-lg"></i>
            Toevoegen
        </button>

    </div>

    @if (!isAuthenticated)
    {
        <div class="alert alert-warning">
            Log in om je abonnementen te bekijken.
        </div>
    }
    else if (memberSubscriptions == null)
    {
        <div class="text-center py-4">
            <div class="spinner-border"></div>
        </div>
    }
    else if (!memberSubscriptions.Any())
    {
        <div class="alert alert-info">
            Je hebt nog geen actieve abonnementen.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var sub in memberSubscriptions.OrderBy(s => s.EndsAtUtc))
            {
                <div class="col-md-6 mb-3">

                    <div class="card border-success shadow-sm">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start">

                                <div>

                                    <h5 class="mb-1">
                                        @GetPlanName(sub.PlanId)
                                    </h5>

                                    <div class="text-muted small">
                                        Status: @sub.Status
                                    </div>

                                </div>

                                <span class="badge bg-success">
                                    Actief
                                </span>

                            </div>

                            <hr />

                            <div class="mb-2">
                                <strong>Start:</strong>
                                @sub.StartsAtUtc.ToString("dd-MM-yyyy")
                            </div>

                            <div class="mb-2">
                                <strong>Einde:</strong>
                                @sub.EndsAtUtc.ToString("dd-MM-yyyy")
                            </div>

                            <div>
                                <strong>Auto renew:</strong>
                                @(sub.AutoRenew ? "Ja" : "Nee")
                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>

@if (isModalOpen)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Subscription toevoegen
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseModal">
                    </button>

                </div>

                <div class="modal-body">

                    @if (!isAuthenticated)
                    {
                        <div class="alert alert-warning">
                            Je moet ingelogd zijn.
                        </div>

                        <button class="btn btn-primary"
                                @onclick='() => Navigation.NavigateTo("/login")'>
                            Naar login
                        </button>
                    }
                    else
                    {
                        <EditForm Model="subscriptionForm"
                                  OnValidSubmit="ConfirmAddSubscription">

                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            @if (selectedPlan != null)
                            {
                                <div class="alert alert-info">
                                    Je gebruikt het bestaande plan: <strong>@selectedPlan.Name</strong>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-secondary">
                                    Vul hieronder een nieuw abonnement in. Het plan wordt eerst aangemaakt.
                                </div>
                            }

                            <div class="mb-3">
                                <label class="form-label">Naam abonnement</label>
                                <InputText class="form-control"
                                           @bind-Value="subscriptionForm.Name"
                                           placeholder="Bijv. Premium" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Prijs</label>
                                <InputNumber class="form-control"
                                             @bind-Value="subscriptionForm.Price" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Periode</label>
                                <InputText class="form-control"
                                           @bind-Value="subscriptionForm.PeriodType"
                                           placeholder="monthly" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Beschrijving</label>
                                <InputTextArea class="form-control"
                                               @bind-Value="subscriptionForm.Description" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Sessies per week</label>
                                <InputNumber class="form-control"
                                             @bind-Value="subscriptionForm.SessionsPerWeekLimit" />
                            </div>

                            @if (!string.IsNullOrWhiteSpace(modalError))
                            {
                                <div class="alert alert-danger">
                                    @modalError
                                </div>
                            }

                            <div class="modal-footer px-0 pb-0">
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        @onclick="CloseModal"
                                        disabled="@createInProgress">
                                    Annuleren
                                </button>

                                <button type="submit"
                                        class="btn btn-success"
                                        disabled="@createInProgress">
                                    @if (createInProgress)
                                    {
                                        <span>
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                            Toevoegen...
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            @(selectedPlan == null ? "Plan en subscription aanmaken" : "Subscription toevoegen")
                                        </span>
                                    }
                                </button>
                            </div>

                        </EditForm>
                    }

                </div>

            </div>

        </div>

    </div>
}

@if (!string.IsNullOrEmpty(pageError))
{
    <div class="alert alert-danger">
        @pageError
    </div>
}

@code {

    private List<MembershipPlanDto>? plans;

    private bool isAuthenticated;

    private string? currentMemberId;

    private IReadOnlyCollection<MemberSubscriptionDto>? memberSubscriptions;

    private bool isModalOpen;

    private MembershipPlanDto? selectedPlan;

    private bool createInProgress;

    private string? modalError;

    private SubscriptionFormModel subscriptionForm = new();

    private string? pageError;

    protected override async Task OnInitializedAsync()
    {
        Language.Changed += OnLanguageChanged;

        await LoadPlans();
        await LoadCurrentMember();
        await LoadSubscriptions();
    }

    private async Task LoadPlans()
    {
        try
        {
            var result = await PlansApi.GetAllAsync();

            plans = result
                .OrderBy(p => p.Price)
                .ToList();
        }
        catch
        {
            plans = new();
            pageError = "Abonnementen konden niet worden geladen.";
        }
    }

    private async Task LoadSubscriptions()
    {
        if (!isAuthenticated ||
            !Guid.TryParse(currentMemberId, out var memberId) ||
            MemberSubscriptionsApi == null)
        {
            memberSubscriptions = new List<MemberSubscriptionDto>();
            return;
        }

        try
        {
            memberSubscriptions = await MemberSubscriptionsApi.GetByMemberAsync(memberId);
        }
        catch (Exception ex) when (ex.Message.Contains("404", StringComparison.OrdinalIgnoreCase))
        {
            memberSubscriptions = new List<MemberSubscriptionDto>();
        }
        catch
        {
            memberSubscriptions = new List<MemberSubscriptionDto>();
            pageError = "Je abonnementen konden niet worden geladen.";
        }
    }

    private async Task LoadCurrentMember()
    {
        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var user = authState.User;

        isAuthenticated =
            user?.Identity?.IsAuthenticated == true;

        currentMemberId =
            user?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    }

    private void OpenSubscriptionModal(MembershipPlanDto plan)
    {
        selectedPlan = plan;

        subscriptionForm = new SubscriptionFormModel
        {
            Name = plan.Name,
            Price = plan.Price,
            PeriodType = plan.PeriodType,
            Description = plan.Description,
            SessionsPerWeekLimit = plan.SessionsPerWeekLimit ?? 0
        };

        modalError = null;
        createInProgress = false;

        isModalOpen = true;
    }

    private void OpenEmptySubscriptionModal()
    {
        selectedPlan = null;
        subscriptionForm = new SubscriptionFormModel();

        modalError = null;
        createInProgress = false;

        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;

        modalError = null;

        createInProgress = false;
    }

    private async Task ConfirmAddSubscription()
    {
        if (MemberSubscriptionsApi == null)
        {
            modalError = "Subscriptions API niet beschikbaar.";
            return;
        }

        if (!Guid.TryParse(currentMemberId, out var memberId))
        {
            modalError = "Je bent niet ingelogd.";
            return;
        }

        try
        {
            createInProgress = true;

            MembershipPlanDto planToUse;

            if (selectedPlan != null)
            {
                planToUse = selectedPlan;
            }
            else
            {
                var newPlan =
                    new MembershipPlanDto
                    {
                        Id = Guid.Empty,
                        Name = subscriptionForm.Name,
                        Price = subscriptionForm.Price,
                        PeriodType = subscriptionForm.PeriodType,
                        Description = subscriptionForm.Description,
                        SessionsPerWeekLimit = subscriptionForm.SessionsPerWeekLimit
                    };

                var createdPlan = await PlansApi.CreateAsync(newPlan);

                if (createdPlan == null)
                {
                    throw new InvalidOperationException("Plan kon niet worden aangemaakt.");
                }

                plans ??= new List<MembershipPlanDto>();
                plans.Add(createdPlan);
                plans = plans.OrderBy(p => p.Price).ToList();

                planToUse = createdPlan;
            }

            var request =
                new CreateMemberSubscriptionRequestDto
                {
                    MemberId = memberId,
                    PlanId = planToUse.Id,
                    AutoRenew = true
                };

            await MemberSubscriptionsApi.CreateAsync(request);

            await LoadSubscriptions();
            CloseModal();
            StateHasChanged();
        }
        catch (Exception ex) when (ex.Message.Contains("404", StringComparison.OrdinalIgnoreCase))
        {
            modalError = "De abonnementen-API route voor aanmaken is niet beschikbaar.";
        }
        catch (Exception ex)
        {
            modalError = ex.Message;
        }
        finally
        {
            createInProgress = false;
        }
    }

    private string GetPlanName(Guid planId)
    {
        return plans?
            .FirstOrDefault(p => p.Id == planId)
            ?.Name
            ?? "Onbekend plan";
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Language.Changed -= OnLanguageChanged;
    }

    public class SubscriptionFormModel : IValidatableObject
    {
        [Required]
        public string Name { get; set; } = "";

        public decimal Price { get; set; }

        [Required]
        public string PeriodType { get; set; } = "monthly";

        public string Description { get; set; } = "";

        [Range(0, int.MaxValue)]
        public int SessionsPerWeekLimit { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Price <= 0)
            {
                yield return new ValidationResult(
                    "Prijs moet groter zijn dan 0.",
                    new[] { nameof(Price) });
            }
        }
    }
}
