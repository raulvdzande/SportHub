@page "/checkout-success"

@using System.Security.Claims
@using SportHub.Shared.DTOs.Members

@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject SportHub.Web.Services.Api.IMemberSubscriptionsApiClient MemberSubscriptionsApi
@inject SportHub.Web.Services.Api.IMembershipPlansApiClient PlansApi

<PageTitle>Betaling geslaagd</PageTitle>

<div class="container mt-5">

    @if (loading)
    {
        <div class="text-center">
            <div class="spinner-border"></div>
            <p class="mt-3">
                Abonnement activeren...
            </p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">
            @error
        </div>
    }
    else
    {
        <div class="card shadow border-0">

            <div class="card-body text-center p-5">

                <h1 class="text-success mb-4">
                    ✔ Betaling geslaagd
                </h1>

                <p class="lead">
                    Je abonnement is succesvol geactiveerd.
                </p>

                <button class="btn btn-primary mt-3"
                        @onclick='() => Navigation.NavigateTo("/subscriptions")'>
                    Naar abonnementen
                </button>

            </div>

        </div>
    }

</div>

@code {

    private bool loading = true;

    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var uri =
                Navigation.ToAbsoluteUri(Navigation.Uri);

            var query =
                System.Web.HttpUtility.ParseQueryString(uri.Query);

            if (!Guid.TryParse(query["planId"], out var planId))
            {
                error = "Geen planId gevonden.";
                return;
            }

            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;

            var memberIdString =
                user?.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (!Guid.TryParse(memberIdString, out var memberId))
            {
                error = "Niet ingelogd.";
                return;
            }

            var existing =
                await MemberSubscriptionsApi
                    .GetByMemberAsync(memberId);

            var alreadyExists =
                existing.Any(x =>
                    x.PlanId == planId &&
                    x.Status == "Active");

            if (!alreadyExists)
            {
                await MemberSubscriptionsApi.CreateAsync(
                    new CreateMemberSubscriptionRequestDto
                    {
                        MemberId = memberId,
                        PlanId = planId,
                        AutoRenew = true
                    });
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}