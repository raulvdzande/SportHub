@page "/admin/recurring-lessons"
@using SportHub.Shared.DTOs.Lessons
@using SportHub.Shared.DTOs.Locations
@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject SportHub.Web.Services.Localization.LanguageService Language
@inject SportHub.Web.Services.Api.ILessonsApiClient LessonsApiClient
@inject SportHub.Web.Services.Api.IWorkoutsApiClient WorkoutsApiClient
@inject SportHub.Web.Services.Api.ILocationsApiClient LocationsApiClient
@inject SportHub.Web.Services.Api.IInstructorsApiClient InstructorsApiClient

<PageTitle>Herhalende Lessen</PageTitle>

<h1>Herhalende Lessen Genereren</h1>

<div class="card">
    <div class="card-header"><h5>Configureer Herhaling</h5></div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Workout</label>
                <select class="form-control" @bind="recurrenceRequest.WorkoutId">
                    <option value="">-- Selecteer --</option>
                    @foreach (var workout in workouts)
                    {
                        <option value="@workout.Id">@workout.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Locatie</label>
                <select class="form-control" @bind="recurrenceRequest.LocationId">
                    <option value="">-- Selecteer --</option>
                    @foreach (var location in locations)
                    {
                        <option value="@location.Id">@location.Name</option>
                    }
                </select>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Instructeur</label>
                <select class="form-control" @bind="recurrenceRequest.InstructorId">
                    <option value="">-- Geen (nnb) --</option>
                    @foreach (var instructor in instructors.Where(x => x.IsActive))
                    {
                        <option value="@instructor.Id">@instructor.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Startdatum/Tijd</label>
                <input type="datetime-local" class="form-control" @bind="startDateTime" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Duur (minuten)</label>
                <input type="number" class="form-control" @bind="recurrenceRequest.DurationMinutes" min="1" max="1440" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Type Herhaling</label>
                <select class="form-control" @bind="recurrence.RecurrenceType">
                    <option>Daily</option>
                    <option>Weekly</option>
                    <option>Monthly</option>
                </select>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Interval</label>
                <input type="number" class="form-control" @bind="recurrence.Interval" min="1" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Tot Datum (of gebruik aantal hieronder)</label>
                <input type="date" class="form-control" @bind="endDate" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 mb-3">
                <label class="form-label">Aantal Voorkomen (max 500)</label>
                <input type="number" class="form-control" @bind="recurrence.OccurrenceCount" min="1" max="500" />
            </div>
        </div>
        <button class="btn btn-primary" @onclick="GenerateRecurring">Genereer Herhalende Lessen</button>
    </div>
</div>

@code {
    private List<WorkoutDto> workouts = new();
    private List<LocationDto> locations = new();
    private List<InstructorDto> instructors = new();
    private GenerateRecurringLessonsRequestDto recurrenceRequest = new();
    private CreateLessonRecurrenceRuleRequestDto recurrence = new();
    private DateTime startDateTime = DateTime.Now;
    private DateTime? endDate;

    protected override async Task OnInitializedAsync()
    {
        Language.Changed += OnLanguageChanged;
        workouts = (await WorkoutsApiClient.GetAllAsync()).ToList();
        locations = (await LocationsApiClient.GetAllAsync()).ToList();
        instructors = (await InstructorsApiClient.GetAllAsync()).ToList();
    }

    private async Task GenerateRecurring()
    {
        recurrence.EndDateUtc = endDate?.ToUniversalTime();
        recurrenceRequest.StartTimeUtc = startDateTime.ToUniversalTime();
        recurrenceRequest.Recurrence = recurrence;
        await LessonsApiClient.GenerateRecurringAsync(recurrenceRequest);
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Language.Changed -= OnLanguageChanged;
    }
}
