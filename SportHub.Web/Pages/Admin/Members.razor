@page "/admin/members"
@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject SportHub.Web.Services.Localization.LanguageService Language
@inject SportHub.Web.Services.Api.IMembersApiClient MembersApiClient

<PageTitle>Leden Beheer</PageTitle>

<h1>Leden Beheer</h1>

<div class="card">
    <div class="card-header">
        <h5>Alle Leden</h5>
    </div>
    <div class="card-body">
        @if (members == null)
        {
            <p>Laden...</p>
        }
        else if (!members.Any())
        {
            <p>Geen leden gevonden.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Naam</th>
                        <th>Email</th>
                        <th>Telefoonnummer</th>
                        <th>Lid sinds</th>
                        <th>Status</th>
                        <th>Abonnement</th>
                        <th>Acties</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in members)
                    {
                        <tr>
                            <td>@member.FirstName @member.LastName</td>
                            <td>@member.Email</td>
                            <td>@member.PhoneNumber</td>
                            <td>@member.CreatedAtUtc:d</td>
                            <td>
                                @if (member.IsActive)
                                {
                                    <span class="badge bg-success">Actief</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactief</span>
                                }
                            </td>
                            <td>-- TODO --</td>
                            <td>
                                <button class="btn btn-sm btn-info">Details</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<SportHub.Shared.DTOs.Members.MemberDto>? members;

    protected override async Task OnInitializedAsync()
    {
        Language.Changed += OnLanguageChanged;
        await LoadMembers();
    }

    private async Task LoadMembers()
    {
        try
        {
            members = (await MembersApiClient.GetAllAsync()).ToList();
        }
        catch
        {
            members = new();
        }
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Language.Changed -= OnLanguageChanged;
    }
}
